+
+    def settle(self):
+        """把本页快照对齐权威操作记录；只有权威终态才清除本地的未决标记。
+
+        另一页面/会话已经确认、拒绝或使授权过期时，本地仍可能保留旧的待确认
+        或未知快照。这里只通过原有 recover() 重新读取原操作（校验归属、摘要与
+        合法状态迁移），不会把 NOT_FOUND 或索引缺失当成未执行，也不会直接改写
+        结果或资金。
+        """
+        try:
+            self.refresh_operations()
+        except ServiceError:
+            return self.blocked
